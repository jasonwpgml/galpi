{
  "name": "galpi-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sample app, galpi CLI and experiment harness for the Galpi Protocol: AI-native codebase navigation for coding agents (Claude Code, Codex)",
  "keywords": [
    "galpi",
    "coding-agents",
    "ai-agents",
    "claude-code",
    "codex",
    "codebase-navigation",
    "ai-native",
    "agents-md",
    "code-index",
    "token-efficiency",
    "llm-benchmark",
    "pretooluse-hook"
  ],
  "license": "Apache-2.0",
  "author": "Jason (https://github.com/jasonwpgml)",
  "homepage": "https://github.com/jasonwpgml/galpi#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jasonwpgml/galpi.git",
    "directory": "galpi-lab"
  },
  "bugs": {
    "url": "https://github.com/jasonwpgml/galpi/issues"
  },
  "scripts": {
    "build": "tsup src/main.ts --format esm --sourcemap --clean",
    "demo": "tsx src/main.ts",
    "start": "node dist/main.js",
    "test": "tsx --test src/auth/auth.test.login.ts src/student/student.test.crud.ts src/lesson/lesson.test.enrollment.ts tools/galpi/galpi.test.ts",
    "typecheck": "tsc --noEmit",
    "galpi": "tsx tools/galpi/cli.ts",
    "check": "npm run typecheck && npm test && npm run galpi -- check && npm run galpi -- build --check && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "js-tiktoken": "^1.0.21",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  }
}
